# Telegram Bot Token from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Database URL (SQLite is default, or PostgreSQL: postgresql+asyncpg://user:pass@localhost:5432/wordseek)
DATABASE_URL=sqlite+aiosqlite:///wordseek.db

# Bot Environment
ENVIRONMENT=development

# Admin User IDs (comma or space separated)
ADMIN_USERS=123456789

# Redis Connection URI (Optional: bot automatically uses In-Memory cache if Redis is not running)
REDIS_URI=redis://127.0.0.1:6379

# Time Zone for Daily Wordle rollover (at 06:00 AM)
TIME_ZONE=UTC

# Daily Wordle Configuration
DAILY_WORDLE_START_DATE=2025-01-01
DAILY_WORDLE_SECRET=wordseek-secret-key-change-me

# Google Gemini API Keys for AI Dictionary Word Hints (Optional)
GEMINI_API_KEYS=

# Telegram Error Logs Channel ID (Optional)
LOGS_CHANNEL=
